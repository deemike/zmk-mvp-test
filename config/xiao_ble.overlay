#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <2>;
        rows = <2>;
        map = <
            RC(0,0) RC(0,1)
            RC(1,0) RC(1,1)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        col-gpios
            = <&gpio0 2 GPIO_ACTIVE_HIGH>  /* Пин D0 */
            , <&gpio0 3 GPIO_ACTIVE_HIGH>  /* Пин D1 */
            ;

        row-gpios
            = <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Пин D2 */
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Пин D3 */
            ;
    };
};

/* Аппаратный UART1 для подключения сканера (Пины D6 и D7) */
&pinctrl {
    uart1_default: uart1_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 11)>; /* Xiao Pin D6 = TX (to Sensor RX) */
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 1, 12)>; /* Xiao Pin D7 = RX (from Sensor TX) */
            bias-pull-up;
        };
    };
    uart1_sleep: uart1_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 11)>,
                    <NRF_PSEL(UART_RX, 1, 12)>;
            low-power-enable;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <57600>;
    pinctrl-0 = <&uart1_default>;
    pinctrl-1 = <&uart1_sleep>;
    pinctrl-names = "default", "sleep";
};

/* Отключаем UART0, чтобы исключить конфликты с ZMK */
&uart0 {
    status = "disabled";
};

/* Отключаем I2C0, чтобы освободить пин D5 (P0.05) под Touch Sensing */
&i2c0 {
    status = "disabled";
};
